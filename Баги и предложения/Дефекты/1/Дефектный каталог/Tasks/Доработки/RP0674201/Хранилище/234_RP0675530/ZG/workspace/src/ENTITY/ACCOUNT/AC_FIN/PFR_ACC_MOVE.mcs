' Валидация обязательных полей и кнопки OK
Public Sub ValidateParam
	' Кнопка расчета доступна, если указаны номер и дата запроса, счет и рег.номер клиента
	OK.Enabled = (P_REQ_NUM <> "" and P_REQ_DATE <> "" and P_ACC_NUM.Text <> "" and txtRegNum.Text  <> "")
	
	' Если дата запроса указана
	if P_REQ_DATE <> "" then
		' то фон даты запроса раскрашивается обычным (белым) цветом
		P_REQ_DATE.BackColor = &h00FFFFFF
	else
		' иначе подсвечивается красным
		P_REQ_DATE.BackColor = &h00DBDAFC
	end if
	
	' Если номер запроса указан
	if P_REQ_NUM <> "" then
		' то фон номера запроса раскрашивается обычным (белым) цветом
		P_REQ_NUM.BackColor = &h00FFFFFF
	else
		' иначе подсвечивается красным
		P_REQ_NUM.BackColor = &h00DBDAFC
	end if
	
	' Если счет указан
	if P_ACC_NUM.Text <> "" then
		' то фон номера счета раскрашивается обычным (белым) цветом
		P_ACC_NUM.BackColor = &h00FFFFFF
	else
		' иначе подсвечивается красным
		P_ACC_NUM.BackColor = &h00DBDAFC
	end if

	' Если рег. номер клиента указан
	if txtRegNum.Text  <> "" then
		' то фон рег. номера клиента раскрашивается обычным (белым) цветом
		txtRegNum.BackColor = &h00FFFFFF
	else
		' иначе подсвечивается красным
		txtRegNum.BackColor = &h00DBDAFC
	end if

	' Если отчет в ПФР
	if ForPFR.Value = 1 then
		' то флаг Выводить примечание для ФСС неактивен
		PrintNoteFSS.Enabled = false
	else ' Если отчет в ФСС
		' то флаг Выводить примечание для ФСС активен
		PrintNoteFSS.Enabled = true
	end if
	
End Sub


Public Function Main(LastControl)
	' "Раскраска" обязательных полей и установка доступности кнопки ОК
	ValidateParam
	Main = True
End Function


' При нажатии Ок
Public Sub Ok_OnClick
	' Запуск монитора коммуникационного канала
	Runtime.ShowMonitor
End Sub


' При изменении даты запроса
Public Sub P_REQ_DATE_OnChange(Cancel)
	' "Раскраска" обязательных полей и установка доступности кнопки ОК
	ValidateParam	
End Sub


' При изменении номера запроса
Public Sub P_REQ_NUM_OnChange(Cancel)
	' "Раскраска" обязательных полей и установка доступности кнопки ОК
	ValidateParam
End Sub

' При изменении рег. номер клиента
Public Sub txtRegNum_OnChange(Cancel)
	' "Раскраска" обязательных полей и установка доступности кнопки ОК
	ValidateParam
End Sub
