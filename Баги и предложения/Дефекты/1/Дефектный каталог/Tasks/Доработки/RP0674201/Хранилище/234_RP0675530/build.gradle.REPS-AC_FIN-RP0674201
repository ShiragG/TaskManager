buildscript {
    dependencies {
        classpath files(CFT_UPDATE_PLUGIN_PATH)
    }
}

apply plugin: ru.cft.platform.ide.plugin.UpdatePlugin

task SetDepend(type: ru.cft.platform.ide.plugin.tasks.SetDepends){
    current_branch = 'REPS/AC_FIN/RP0674201'
    dependency_branch = ''
}

task ImportZip(type: ru.cft.platform.ide.plugin.tasks.ImportElement){
    dependsOn SetDepend
    storage_file = 'patch.zip'
    pck_file = 'patch.pck'
    compilation = true
}

task run(type: ru.cft.platform.ide.plugin.tasks.Run){
    dependsOn ImportZip
}
